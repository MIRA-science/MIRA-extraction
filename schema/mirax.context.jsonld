{
  "_comment": "Hand-authored JSON-LD term block for the mirax extension. Output graph-LD uses @context = [ <MIRA PURL>, this block ] (SPEC §5.3/§10). Authored by hand because gen-jsonld-context conflicts on the overlay's re-declared imported classes (a known LinkML quirk; gen-pydantic + gen-json-schema are unaffected). Keep in sync with mira_x.yaml slot_uris.",
  "@context": {
    "mirax": "http://purl.org/mira-science/extraction#",
    "mira":  "http://purl.org/mira-science/mira#",
    "dgb":   "https://discoursegraphs.com/schema/dg_base#",

    "source_span":       { "@id": "mirax:sourceSpan" },
    "provenance":        { "@id": "mirax:provenance" },
    "epistemic_status":  { "@id": "mirax:epistemicStatus" },
    "activity_modality": { "@id": "mirax:activityModality" },
    "curation_status":   { "@id": "mirax:curationStatus" },
    "content_hash":      { "@id": "mirax:contentHash" },

    "agent_kind":        { "@id": "mirax:agentKind" },
    "identifier":        { "@id": "mirax:identifier" },
    "external_ids":      { "@id": "mirax:externalIds" },
    "affiliated_with":   { "@id": "mirax:affiliatedWith", "@type": "@id" },

    "relation_type":     { "@id": "mirax:relationType", "@type": "@id" },
    "source":            { "@id": "dgb:source", "@type": "@id" },
    "destination":       { "@id": "dgb:destination", "@type": "@id" },

    "members":           { "@id": "mirax:members" },
    "ref":               { "@id": "mirax:ref", "@type": "@id" },
    "prose":             { "@id": "mirax:prose" },
    "prose_blob":        { "@id": "mirax:proseBlob" },
    "abstract":          { "@id": "mirax:abstract" },
    "references":        { "@id": "mirax:references" },

    "funder":            { "@id": "mira:funder", "@type": "@id" },
    "endorsed":          { "@id": "mira:endorsed", "@type": "@id" },
    "scope":             { "@id": "mira:scope", "@type": "@id" }
  }
}
