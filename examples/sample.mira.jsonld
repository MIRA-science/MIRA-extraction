    {
      "@id": "x:a-n0",
      "@type": "Item",
      "format": "text/plain",
      "content": "remain retrievable over a 30-day observation window",
      "has_container": "x:doc"
    },
    {
      "@id": "x:a-n1",
      "@type": "Item",
      "format": "text/plain",
      "content": "we conclude that content addressing preserves retrievability",
      "has_container": "x:doc"
    },
    {
      "@id": "x:a-n3",
      "@type": "Item",
      "format": "text/plain",
      "content": "470 (94%) were still retrievable on day 30",
      "has_container": "x:doc"
    },
    {
      "@id": "x:a-n5",
      "@type": "Item",
      "format": "text/plain",
      "content": "we audited 500 objects over 30 days",
      "has_container": "x:doc"
    },
    {
      "@id": "x:a-n6",
      "@type": "Item",
      "format": "text/plain",
      "content": "each CID was probed once every 24 hours",
      "has_container": "x:doc"
    },
    {
      "@id": "x:a-n9",
      "@type": "Item",
      "format": "text/plain",
      "content": "future work should extend the audit to a full year",
      "has_container": "x:doc"
    },
    {
      "@id": "x:a-r1",
      "@type": "Item",
      "format": "text/plain",
      "content": "this result supports the retrievability conclusion",
      "has_container": "x:doc"
    },
